{
    "name": "monk24215/mailcow-deliverability-mcp-php",
    "description": "MCP server that reads Postfix delivery logs and reports per-provider sending reputation. PHP port of the deliverability layer of mailcow-mpc-showcase.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristian Oubre"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "mcp/sdk": "^0.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MailcowDeliverability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailcowDeliverability\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/server.php"
        ],
        "serve-http": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8080 public/index.php"
        ],
        "test": "phpunit",
        "smoke": "@php bin/smoke-test.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable"
}
